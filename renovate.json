{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitType(chore)",
    ":semanticCommitScope(deps)"
  ],
  "labels": ["dependencies", "renovate"],
  "baseBranchPatterns": ["develop"],
  "timezone": "UTC",
  "schedule": [],
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "customDatasources": {
    "centosStream9ProductionCompose": {
      "defaultRegistryUrlTemplate": "https://composes.stream.centos.org/stream-9/production/",
      "format": "html"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "klauspost/compress security dependency pin in Dockerfile",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "ARG\\s+GO_KLAUSPOST_COMPRESS_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"
      ],
      "datasourceTemplate": "go",
      "depNameTemplate": "github.com/klauspost/compress",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Fulcio security replacement in the source-built Cosign CLI",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+COSIGN_FULCIO_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "go",
      "depNameTemplate": "github.com/sigstore/fulcio",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Rekor security replacement in the source-built Cosign CLI",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+COSIGN_REKOR_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "go",
      "depNameTemplate": "github.com/sigstore/rekor",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Cosign source tuple; signed tag, immutable commit and archive checksum require reviewed manual updates",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+COSIGN_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\nARG\\s+COSIGN_SOURCE_COMMIT=[a-f0-9]{40}\\s*\\nARG\\s+COSIGN_SOURCE_SHA256=[a-f0-9]{64}\\s*\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "sigstore/cosign",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "CentOS Stream 9 production compose pin in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+CENTOS_STREAM_COMPOSE=CentOS-Stream-9-(?<currentValue>[0-9]{8}\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "custom.centosStream9ProductionCompose",
      "depNameTemplate": "centos-stream-9-production-compose",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "pip version pin in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/", "/^Containerfile$/"],
      "matchStrings": ["ARG\\s+PIP_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "depNameTemplate": "pip",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "description": "Packer source tuple in Dockerfile; updates require an immutable commit and archive checksum",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+PACKER_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\nARG\\s+PACKER_SOURCE_COMMIT=[a-f0-9]{40}\\s*\\nARG\\s+PACKER_SOURCE_SHA256=[a-f0-9]{64}\\s*\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hashicorp/packer",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Incus client source tuple in Dockerfile; updates require an immutable commit and archive checksum",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+INCUS_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\nARG\\s+INCUS_SOURCE_COMMIT=[a-f0-9]{40}\\s*\\nARG\\s+INCUS_SOURCE_SHA256=[a-f0-9]{64}\\s*\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "lxc/incus",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "TFLint version pin in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+TFLINT_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "terraform-linters/tflint",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "terraform-docs version pin in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+TF_DOCS_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "terraform-docs/terraform-docs",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Terragrunt version pin in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/", "/^Containerfile$/"],
      "matchStrings": ["ARG\\s+TERRAGRUNT_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "gruntwork-io/terragrunt",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Helm version pin in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/", "/^Containerfile$/"],
      "matchStrings": ["ARG\\s+HELM_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "helm/helm",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Node.js LTS version pin in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+NODE_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Website-selected Node.js version pin in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+WEBSITE_NODE_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "node-version",
      "packageNameTemplate": "node",
      "depNameTemplate": "node-website-runtime"
    },
    {
      "customType": "regex",
      "description": "GitHub CLI version pin in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+GH_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cli/cli",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "actionlint version pin in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+ACTIONLINT_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rhysd/actionlint",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Docker Compose version pin in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+COMPOSE_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "docker/compose",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Docker Buildx source version pin in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+BUILDX_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "docker/buildx",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "gRPC-Go security override in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+GO_GRPC_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "go",
      "depNameTemplate": "google.golang.org/grpc",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Go x/crypto security override in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+GO_X_CRYPTO_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "go",
      "depNameTemplate": "golang.org/x/crypto",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Go x/net security override in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+GO_X_NET_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "go",
      "depNameTemplate": "golang.org/x/net",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Go x/text security override in Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG\\s+GO_X_TEXT_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\s*\\n"],
      "datasourceTemplate": "go",
      "depNameTemplate": "golang.org/x/text",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^collections/requirements-base\\.yml$/", "/^collections/controller-requirements\\.yml$/"],
      "matchStrings": ["-\\s+name:\\s+(?<depName>[A-Za-z0-9_]+\\.[A-Za-z0-9_]+)\\s*\\n\\s+version:\\s+\"?(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\"?\\s*\\n"],
      "datasourceTemplate": "galaxy-collection",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^collections/requirements-base\\.yml$/"],
      "matchStrings": ["-\\s+name:\\s+https://github\\.com/(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\\.git\\s*\\n\\s+type:\\s+git\\s*\\n\\s+version:\\s+\"?(?<currentValue>[^\"\\n]+)\"?"],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "ee-wunder-devtools-ubi9 image pins in scripts and README",
      "managerFilePatterns": [
        "/(^|.*/)scripts/.*\\.(?:sh|py)$/",
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "quay\\.io/l-it/ee-wunder-devtools-ubi9:v(?<currentValue>[0-9.]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "quay.io/l-it/ee-wunder-devtools-ubi9"
    }
  ],
  "packageRules": [
    {
      "description": "Maintain Source-owned Python inputs and hash locks in shared-assets-lit only",
      "matchFileNames": [
        "requirements.in",
        "requirements.lock",
        "requirements.txt"
      ],
      "enabled": false
    },
    {
      "description": "Keep markdown-it 14 on the patched compatible security line",
      "matchManagers": [
        "npm"
      ],
      "matchDepNames": [
        "markdown-it"
      ],
      "matchCurrentVersion": "/^14\\./",
      "allowedVersions": ">=14.3.3 <15"
    },
    {
      "description": "Keep markdown-it 15 on the patched compatible security line",
      "matchManagers": [
        "npm"
      ],
      "matchDepNames": [
        "markdown-it"
      ],
      "matchCurrentVersion": "/^15\\./",
      "allowedVersions": ">=15.0.3 <16"
    },
    {
      "description": "Update Cosign signed tag, source commit, version and archive SHA-256 together in a reviewed manual change",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["sigstore/cosign"],
      "enabled": false,
      "automerge": false
    },
    {
      "description": "Use the upstream Renovate runtime with native simple-git 4 support; no version-specific compatibility patch",
      "matchManagers": ["npm"],
      "matchFileNames": ["container-toolchain/package.json"],
      "matchPackageNames": ["renovate"],
      "allowedVersions": ">=44.145.2"
    },
    {
      "description": "Extract dated CentOS Stream 9 production compose versions",
      "matchDatasources": ["custom.centosStream9ProductionCompose"],
      "extractVersion": "^CentOS-Stream-9-(?<version>[0-9]{8}\\.[0-9]+)/$",
      "schedule": ["before 5am on monday"]
    },
    {
      "description": "Do not update Renovate configuration dependencies",
      "matchManagers": ["renovate-config"],
      "enabled": false
    },
    {
      "description": "Keep the website Node runtime synchronized with its repository contract",
      "matchDepNames": ["node-website-runtime"],
      "enabled": false
    },
    {
      "description": "Automerge safe non-major updates into develop after CI passes",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "addLabels": ["safe-automerge"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Require manual approval for major updates",
      "matchUpdateTypes": ["major"],
      "addLabels": ["breaking-update"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Update Packer version, immutable source commit and source archive SHA-256 together in a reviewed manual change",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["hashicorp/packer"],
      "enabled": false,
      "automerge": false
    },
    {
      "description": "Update Incus client version, immutable source commit and source archive SHA-256 together in a reviewed manual change",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["lxc/incus"],
      "enabled": false,
      "automerge": false
    },
    {
      "description": "Keep the conventional-commits preset compatible with writer 8",
      "matchManagers": ["npm"],
      "matchPackageNames": ["conventional-changelog-conventionalcommits"],
      "allowedVersions": "/^9\\./"
    },
    {
      "description": "Keep every component of the GitHub Actions toolchain on one version",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Do not update shared-assets-owned workflow files downstream",
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        ".github/workflows/codex-copilot-remediation.yml",
        ".github/workflows/container-build-publish.yml",
        ".github/workflows/container-build.yml",
        ".github/workflows/container-ci.yml",
        ".github/workflows/container-fuzz.yml",
        ".github/workflows/container-trivy.yml",
        ".github/workflows/copilot-review-refresh.yml",
        ".github/workflows/copilot-review.yml",
        ".github/workflows/current-revision-rerun.yml",
        ".github/workflows/main-promotion-authorization.yml",
        ".github/workflows/openssf-scorecard.yml",
        ".github/workflows/promote-develop-to-main.yml",
        ".github/workflows/release-bot-exact-head-review.yml",
        ".github/workflows/renovate-guarded-automerge.yml",
        ".github/workflows/rpm-srpm-ci.yml",
        ".github/workflows/security-release-finalize.yml",
        ".github/workflows/security-release-guard.yml",
        ".github/workflows/security-release-promote-tags.yml",
        ".github/workflows/security-release-reconcile.yml",
        ".github/workflows/security-release-update.yml",
        ".github/workflows/semantic-release.yml",
        ".github/workflows/shared-assets-guarded-automerge.yml",
        ".github/workflows/sync-main-to-develop.yml"
      ],
      "enabled": false
    }
  ]
}
